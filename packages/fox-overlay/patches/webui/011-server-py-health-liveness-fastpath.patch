+    def _read_request_line_bounded(self, request, *, deadline_seconds: float = 2.0,
+                                   max_bytes: int = 8192) -> bytes:
+        # Fox #913: read up to the first CRLF under a TOTAL wall-clock deadline
+        # (not the per-recv timeout), so peeking the request line in the
+        # overflow lane cannot itself become a slowloris surface.
+        deadline = time.monotonic() + deadline_seconds
+        buffered = bytearray()
+        try:
+            original_timeout = request.gettimeout()
+        except Exception:
+            original_timeout = None
+        try:
+            while len(buffered) < max_bytes and b"\r\n" not in buffered:
+                wait = deadline - time.monotonic()
+                if wait <= 0:
+                    break
+                try:
+                    request.settimeout(wait)
+                    chunk = request.recv(min(1024, max_bytes - len(buffered)))
+                except (BlockingIOError, InterruptedError, TimeoutError, socket.timeout, OSError):
+                    break
+                if not chunk:
+                    break
+                buffered.extend(chunk)
+        finally:
+            try:
+                request.settimeout(original_timeout)
+            except Exception:
+                pass
+        return bytes(buffered)
+
+    def _is_health_liveness_probe(self, request_line: bytes) -> bool:
+        # Exact "/health" with NO query string only.  Never /readyz (a deep
+        # dependency probe) and never /health?deep=1 — those must fall through
+        # to the real handler so a degraded subsystem is never masked by a
+        # canned 200.
+        try:
+            parts = request_line.split(b"\r\n", 1)[0].split()
+            if len(parts) < 2 or parts[0].upper() not in (b"GET", b"HEAD"):
+                return False
+            return parts[1] == b"/health"
+        except Exception:
+            return False
+
